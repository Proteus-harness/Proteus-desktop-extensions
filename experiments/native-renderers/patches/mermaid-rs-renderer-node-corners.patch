+fn diamond_polygon_points(node: &crate::layout::NodeLayout) -> String {
+    let (x, y, w, h) = (node.x, node.y, node.width, node.height);
+    format!("{:.2},{:.2} {:.2},{:.2} {:.2},{:.2} {:.2},{:.2}",
+        x + w / 2.0, y, x + w, y + h / 2.0, x + w / 2.0, y + h, x, y + h / 2.0)
