+/// Reuse the existing six-point cleanup for a tiny U-turn inside a longer route.
+/// Keep large-graph fast tiers untouched and bound both passes and local windows.
+pub(in crate::layout) fn simplify_flowchart_micro_detours(
+    graph: &Graph,
+    nodes: &BTreeMap<String, NodeLayout>,
+    obstacles: &[Obstacle],
+    label_obstacles: &[Obstacle],
+    routed_points: &mut [Vec<(f32, f32)>],
+) {
+    if graph.edges.len() > 64 {
+        return;
+    }
+    for idx in 0..routed_points.len() {
+        let edge = &graph.edges[idx];
+        if edge.from == edge.to
+            || !routed_points[idx].windows(4).any(|p| {
+                let middle = (p[2].0 - p[1].0).abs().max((p[2].1 - p[1].1).abs());
+                let dot =
+                    (p[1].0 - p[0].0) * (p[3].0 - p[2].0) + (p[1].1 - p[0].1) * (p[3].1 - p[2].1);
+                middle <= 4.0 && dot < 0.0
+            })
+        {
+            continue;
+        }
+        let mut other_segments = Vec::new();
+        for (other_idx, path) in routed_points.iter().enumerate() {
+            if other_idx != idx {
+                append_path_segments(path, &mut other_segments);
+            }
+        }
+        for _ in 0..2 {
+            let baseline = &routed_points[idx];
+            let (base_cross, base_overlap) =
+                edge_crossings_with_existing(baseline, &other_segments);
+            let base_reentries = flowchart_endpoint_reentry_count(baseline, edge, nodes);
+            let obstacle_hits: Vec<_> = obstacles
+                .iter()
+                .map(|obstacle| {
+                    path_obstacle_intersections(
+                        baseline,
+                        std::slice::from_ref(obstacle),
+                        &edge.from,
+                        &edge.to,
+                    )
+                })
+                .collect();
+            let label_hits: Vec<_> = label_obstacles
+                .iter()
+                .map(|label| path_label_intersections(baseline, std::slice::from_ref(label), None))
+                .collect();
+            let mut best: Option<Vec<(f32, f32)>> = None;
+            let mut best_bends = path_bend_count(baseline);
+            let mut best_len = path_length(baseline);
+            for start in 0..baseline.len().saturating_sub(5).min(32) {
+                let window = &baseline[start..start + 6];
+                for local in detour_rectangle_simplification_candidates(window)
+                    .into_iter()
+                    .chain(shoulder_simplification_candidates(window))
+                {
+                    let mut candidate = Vec::with_capacity(baseline.len());
+                    candidate.extend_from_slice(&baseline[..start]);
+                    candidate.extend(local);
+                    candidate.extend_from_slice(&baseline[start + 6..]);
+                    let candidate = compress_path(&candidate);
+                    let bends = path_bend_count(&candidate);
+                    let len = path_length(&candidate);
+                    if bends >= best_bends || len >= best_len || candidate.len() < 2 {
+                        continue;
+                    }
+                    // Preserve both exact terminal directions, including port normals.
+                    if [false, true].into_iter().any(|end| {
+                        let (a, b) = if end {
+                            (baseline.len() - 1, candidate.len() - 1)
+                        } else {
+                            (0, 0)
+                        };
+                        let (an, bn) = if end { (a - 1, b - 1) } else { (1, 1) };
+                        (baseline[an].0 - baseline[a].0) * (candidate[bn].0 - candidate[b].0)
+                            + (baseline[an].1 - baseline[a].1) * (candidate[bn].1 - candidate[b].1)
+                            <= 0.0
+                    }) || flowchart_path_hits_non_endpoint_nodes(
+                        &candidate, &edge.from, &edge.to, nodes,
+                    ) || flowchart_endpoint_reentry_count(&candidate, edge, nodes)
+                        > base_reentries
+                        || obstacles
+                            .iter()
+                            .zip(&obstacle_hits)
+                            .any(|(obstacle, hits)| {
+                                path_obstacle_intersections(
+                                    &candidate,
+                                    std::slice::from_ref(obstacle),
+                                    &edge.from,
+                                    &edge.to,
+                                ) > *hits
+                            })
+                        || label_obstacles
+                            .iter()
+                            .zip(&label_hits)
+                            .any(|(label, hits)| {
+                                path_label_intersections(
+                                    &candidate,
+                                    std::slice::from_ref(label),
+                                    None,
+                                ) > *hits
+                            })
+                    {
+                        continue;
+                    }
+                    let (cross, overlap) =
+                        edge_crossings_with_existing(&candidate, &other_segments);
+                    if cross > base_cross || overlap > base_overlap + 0.05 {
+                        continue;
+                    }
+                    best_bends = bends;
+                    best_len = len;
+                    best = Some(candidate);
+                }
+            }
+            let Some(best) = best else { break };
+            routed_points[idx] = best;
+        }
+    }
+}
