{
  "protocol": 4,
  "id": "markdown-render",
  "title": "Markdown",
  "description": "Нативный форматированный текст и подключаемые визуализации в ответах.",
  "icon": "file-text",
  "command": ["bin/markdown-render"],
  "surfaces": {
    "content": {"formats": ["text/markdown"], "languages": ["md", "markdown"]}
