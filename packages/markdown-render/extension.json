        "markdown"
      ]
    },
    "preview": {}
  },
  "required_features": [
    "widgets.rich_text.inlines.v1",
    "surfaces.content.v1",
    "widgets.rich_text.v1",
    "widgets.content.v1",
    "widgets.code_embedded.v1",
    "surfaces.preview.v1"
  ],
  "author": "Proteus Project",
  "_meta": {
    "org.proteus/tags": [
      "Рендерер"
    ]
  }
}
